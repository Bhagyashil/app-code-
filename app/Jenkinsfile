pipeline {
    agent any

    // ─── PARAMETERS ───────────────────────────────────────────────────────────
    parameters {
        string(
            name: 'APP_FOLDER',
            defaultValue: 'app',
            description: 'Folder to build from (e.g. app)'
        )
        booleanParam(
            name: 'FORCE_BUILD',
            defaultValue: false,
            description: 'Force build even if no changes in app folder'
        )
    }

    environment {
        // ── AWS CONFIG ─────────────────────────────────────────────────────────
        AWS_CREDENTIALS    = credentials('aws-credentials')
        AWS_REGION         = "us-east-1"                          // ← change to your region
        AWS_ACCOUNT_ID     = "123456789012"                       // ← your AWS account ID

        // ── ECR CONFIG ─────────────────────────────────────────────────────────
        ECR_REPO_NAME      = "your-app-name"                      // ← your ECR repo name
        ECR_REGISTRY       = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        IMAGE_URI          = "${ECR_REGISTRY}/${ECR_REPO_NAME}"
        IMAGE_TAG          = "${env.BRANCH_NAME}-${env.BUILD_NUMBER}"
    }

    stages {

        // ─── 1. CHECKOUT ──────────────────────────────────────────────────────
        stage('Checkout') {
            steps {
                echo "Checking out code from GitHub..."
                checkout scm
            }
        }

        // ─── 2. CHECK IF APP FOLDER HAS CHANGES ──────────────────────────────
        stage('Check App Folder Changes') {
            steps {
                script {
                    echo "Checking for changes in '${params.APP_FOLDER}/' folder..."

                    def changedFiles = sh(
                        script: "git diff --name-only HEAD~1 HEAD || echo 'first-commit'",
                        returnStdout: true
                    ).trim()

                    echo "Changed files:\n${changedFiles}"

                    // Check if any changed file is inside app folder
                    def appChanged = changedFiles.contains("${params.APP_FOLDER}/") || 
                                     changedFiles == 'first-commit'

                    if (appChanged || params.FORCE_BUILD) {
                        echo "✅ Changes detected in '${params.APP_FOLDER}/' — proceeding with build."
                        env.SHOULD_BUILD = "true"
                    } else {
                        echo "⏭️  No changes in '${params.APP_FOLDER}/' folder — skipping build."
                        env.SHOULD_BUILD = "false"
                    }
                }
            }
        }

        // ─── 3. BUILD DOCKER IMAGE ────────────────────────────────────────────
        stage('Build Docker Image') {
            when {
                expression { env.SHOULD_BUILD == "true" }
            }
            steps {
                echo "Building Docker image from '${params.APP_FOLDER}/' folder..."
                sh """
                    docker build -t ${IMAGE_URI}:${IMAGE_TAG} ./${params.APP_FOLDER}
                    docker tag  ${IMAGE_URI}:${IMAGE_TAG} ${IMAGE_URI}:latest
                """
            }
        }

        // ─── 4. LOGIN TO AWS ECR ──────────────────────────────────────────────
        stage('Login to AWS ECR') {
            when {
                expression { env.SHOULD_BUILD == "true" }
            }
            steps {
                echo "Authenticating with AWS ECR..."
                sh """
                    export AWS_ACCESS_KEY_ID=${AWS_CREDENTIALS_USR}
                    export AWS_SECRET_ACCESS_KEY=${AWS_CREDENTIALS_PSW}

                    aws ecr get-login-password --region ${AWS_REGION} \
                        | docker login --username AWS --password-stdin ${ECR_REGISTRY}
                """
            }
        }

        // ─── 5. ENSURE ECR REPO EXISTS ────────────────────────────────────────
        stage('Ensure ECR Repository') {
            when {
                expression { env.SHOULD_BUILD == "true" }
            }
            steps {
                echo "Ensuring ECR repository exists..."
                sh """
                    export AWS_ACCESS_KEY_ID=${AWS_CREDENTIALS_USR}
                    export AWS_SECRET_ACCESS_KEY=${AWS_CREDENTIALS_PSW}

                    aws ecr describe-repositories \
                        --repository-names ${ECR_REPO_NAME} \
                        --region ${AWS_REGION} \
                    || aws ecr create-repository \
                        --repository-name ${ECR_REPO_NAME} \
                        --region ${AWS_REGION} \
                        --image-scanning-configuration scanOnPush=true
                """
            }
        }

        // ─── 6. PUSH TO ECR ───────────────────────────────────────────────────
        stage('Push to AWS ECR') {
            when {
                allOf {
                    expression { env.SHOULD_BUILD == "true" }
                    anyOf {
                        branch 'main'
                        branch 'master'
                        branch 'bhagyashil/devOps'
                    }
                }
            }
            steps {
                echo "Pushing image to ECR..."
                sh """
                    docker push ${IMAGE_URI}:${IMAGE_TAG}
                    docker push ${IMAGE_URI}:latest
                """
            }
        }
    }

    // ─── POST ACTIONS ─────────────────────────────────────────────────────────
    post {
        success {
            script {
                if (env.SHOULD_BUILD == "true") {
                    echo "✅ Image pushed successfully!"
                    echo "   URI : ${IMAGE_URI}:${IMAGE_TAG}"
                    echo "   From: ${params.APP_FOLDER}/ folder"
                } else {
                    echo "⏭️  Build skipped — no changes in '${params.APP_FOLDER}/' folder."
                }
            }
        }
        failure {
            echo "❌ Pipeline failed. Check logs above."
        }
        always {
            sh """
                docker rmi ${IMAGE_URI}:${IMAGE_TAG} || true
                docker rmi ${IMAGE_URI}:latest       || true
                docker image prune -f               || true
            """
        }
    }
}