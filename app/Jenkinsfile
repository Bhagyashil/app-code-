pipeline {
    agent any

    parameters {
        choice(
            name: 'FOLDER',
            choices: ['app', 'dev'],
            description: 'Select which folder to build and push to AWS ECR'
        )
    }

    environment {
        AWS_REGION      = "us-east-1"
        AWS_ACCOUNT_ID  = "204298492808"
        ECR_REPO_NAME   = "${params.FOLDER}-app"
        ECR_REGISTRY    = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        IMAGE_URI       = "${ECR_REGISTRY}/${ECR_REPO_NAME}"
        IMAGE_TAG       = "${params.FOLDER}-${env.BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                echo "Checking out code from GitHub..."
                checkout scm
            }
        }

        stage('Selected Folder Info') {
            steps {
                echo "========================================="
                echo "  Building from folder : ${params.FOLDER}/"
                echo "  Docker Image         : ${IMAGE_URI}:${IMAGE_TAG}"
                echo "========================================="
            }
        }

        stage('Build Docker Image') {
            steps {
                echo "Building Docker image from '${params.FOLDER}/' folder..."
                sh """
                    docker build -t ${IMAGE_URI}:${IMAGE_TAG} ./${params.FOLDER}
                    docker tag  ${IMAGE_URI}:${IMAGE_TAG} ${IMAGE_URI}:latest
                """
            }
        }

        stage('Login to AWS ECR') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-credential',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    sh '''
                        aws ecr get-login-password --region us-east-1 | \
                        docker login --username AWS --password-stdin \
                        204298492808.dkr.ecr.us-east-1.amazonaws.com
                    '''
                }
            }
        }

        stage('Ensure ECR Repository') {
            steps {
                echo "Ensuring ECR repository '${ECR_REPO_NAME}' exists..."
                withCredentials([[                          // ✅ FIXED
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-credential',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    sh """
                        aws ecr describe-repositories \
                            --repository-names ${ECR_REPO_NAME} \
                            --region ${AWS_REGION} \
                        || aws ecr create-repository \
                            --repository-name ${ECR_REPO_NAME} \
                            --region ${AWS_REGION} \
                            --image-scanning-configuration scanOnPush=true
                    """
                }
            }
        }

        stage('Push to AWS ECR') {
            steps {
                echo "Pushing '${params.FOLDER}' image to ECR..."
                withCredentials([[                          // ✅ FIXED
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-credential',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    sh """
                        docker push ${IMAGE_URI}:${IMAGE_TAG}
                        docker push ${IMAGE_URI}:latest
                    """
                }
            }
        }
    }

    post {
        success {
            echo "✅ '${params.FOLDER}' folder built and pushed successfully!"
            echo "   Image URI : ${IMAGE_URI}:${IMAGE_TAG}"
        }
        failure {
            echo "❌ Pipeline failed for '${params.FOLDER}' folder. Check logs above."
        }
        always {
            sh """
                docker rmi ${IMAGE_URI}:${IMAGE_TAG} || true
                docker rmi ${IMAGE_URI}:latest       || true
                docker image prune -f               || true
            """
        }
    }
}